{
  "openapi": "3.1.0",
  "info": {
    "title": "Dashboard Mac — API locale",
    "version": "1.0.0",
    "description": "Servizio su 127.0.0.1. Host e Origin verificati; nessun CORS. Il token di sessione si ottiene con GET /api/session. Nessun file di progetto viene modificato. Le scansioni concorrenti condividono lo stesso lavoro."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:4317"
    }
  ],
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Dashboard-Token"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Project": {
        "type": "object",
        "required": [
          "id",
          "name",
          "path",
          "rootId",
          "type",
          "modifiedAt",
          "git",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "rootId": {
            "type": "string"
          },
          "rootLabel": {
            "type": "string"
          },
          "displayPath": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "modifiedAt": {
            "type": "string",
            "format": "date-time"
          },
          "git": {
            "type": "boolean"
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Catalog": {
        "type": "object",
        "required": [
          "projects",
          "roots",
          "warnings",
          "scannedAt",
          "visited",
          "durationMs"
        ],
        "properties": {
          "projects": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Project"
            }
          },
          "roots": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "label",
                "path"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "depth": {
                  "type": "integer"
                }
              }
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scannedAt": {
            "type": "string",
            "format": "date-time"
          },
          "visited": {
            "type": "integer"
          },
          "durationMs": {
            "type": "integer"
          }
        }
      },
      "Resources": {
        "type": "object",
        "required": [
          "sampledAt",
          "system",
          "projects",
          "sharedServices",
          "topProcesses",
          "diskScan",
          "warnings"
        ],
        "properties": {
          "sampledAt": {
            "type": "string",
            "format": "date-time"
          },
          "system": {
            "type": "object",
            "required": [
              "cpuPercent",
              "logicalCores",
              "memory",
              "disk"
            ],
            "properties": {
              "cpuPercent": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "logicalCores": {
                "type": "integer"
              },
              "memory": {
                "type": "object",
                "required": [
                  "totalBytes",
                  "usedBytes",
                  "availableBytes",
                  "compressedBytes",
                  "swapUsedBytes",
                  "method"
                ],
                "properties": {
                  "totalBytes": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "usedBytes": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "availableBytes": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "compressedBytes": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "swapUsedBytes": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "method": {
                    "enum": [
                      "vm_stat-estimate",
                      "total-minus-free"
                    ]
                  }
                }
              },
              "disk": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "totalBytes": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "usedBytes": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "availableBytes": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  }
                }
              }
            }
          },
          "projects": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "cpuPercent",
                "rssBytes",
                "processCount",
                "processes",
                "attribution",
                "disk"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "cpuPercent": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "rssBytes": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "processCount": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "processes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "pid",
                      "name",
                      "cpuPercent",
                      "rssBytes"
                    ],
                    "properties": {
                      "pid": {
                        "type": "integer"
                      },
                      "name": {
                        "type": "string"
                      },
                      "cpuPercent": {
                        "type": "number"
                      },
                      "rssBytes": {
                        "type": "integer"
                      }
                    }
                  }
                },
                "attribution": {
                  "enum": [
                    "cwd-and-descendants",
                    "unavailable"
                  ]
                },
                "disk": {
                  "type": "object",
                  "required": [
                    "status",
                    "bytes",
                    "measuredAt",
                    "error"
                  ],
                  "properties": {
                    "status": {
                      "enum": [
                        "idle",
                        "pending",
                        "complete",
                        "error"
                      ]
                    },
                    "bytes": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "measuredAt": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "error": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "sharedServices": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "pid",
                "name",
                "cpuPercent",
                "rssBytes"
              ],
              "properties": {
                "pid": {
                  "type": "integer"
                },
                "name": {
                  "type": "string"
                },
                "cpuPercent": {
                  "type": "number"
                },
                "rssBytes": {
                  "type": "integer"
                }
              }
            }
          },
          "topProcesses": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "pid",
                "name",
                "cpuPercent",
                "rssBytes"
              ],
              "properties": {
                "pid": {
                  "type": "integer"
                },
                "name": {
                  "type": "string"
                },
                "cpuPercent": {
                  "type": "number"
                },
                "rssBytes": {
                  "type": "integer"
                }
              }
            }
          },
          "diskScan": {
            "type": "object",
            "required": [
              "running",
              "completed",
              "total"
            ],
            "properties": {
              "running": {
                "type": "boolean"
              },
              "completed": {
                "type": "integer"
              },
              "total": {
                "type": "integer"
              }
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "LaunchProfile": {
        "type": "object",
        "required": [
          "command",
          "directory",
          "url"
        ],
        "properties": {
          "command": {
            "type": "string",
            "maxLength": 1500
          },
          "directory": {
            "type": "string",
            "maxLength": 500
          },
          "url": {
            "type": "string"
          }
        }
      },
      "RuntimeProject": {
        "type": "object",
        "required": [
          "id",
          "name",
          "path",
          "profile",
          "suggestions",
          "status",
          "pid",
          "startedAt",
          "endedAt",
          "exitCode",
          "error"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "profile": {
            "$ref": "#/components/schemas/LaunchProfile"
          },
          "suggestions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "idle",
              "running",
              "stopping",
              "exited",
              "error"
            ]
          },
          "pid": {
            "type": [
              "integer",
              "null"
            ]
          },
          "startedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "endedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "exitCode": {
            "type": [
              "integer",
              "null"
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ProjectMetadata": {
        "type": "object",
        "required": [
          "description",
          "client",
          "status",
          "notes",
          "updatedAt"
        ],
        "properties": {
          "description": {
            "type": "string",
            "maxLength": 1000
          },
          "client": {
            "type": "string",
            "maxLength": 200
          },
          "status": {
            "enum": [
              "active",
              "paused",
              "archived"
            ]
          },
          "notes": {
            "type": "string",
            "maxLength": 6000
          },
          "updatedAt": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "GitState": {
        "type": "object",
        "required": [
          "state"
        ],
        "properties": {
          "state": {
            "enum": [
              "none",
              "parent",
              "error",
              "ready"
            ]
          },
          "message": {
            "type": "string"
          },
          "branch": {
            "type": "string"
          },
          "repositoryUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "ahead": {
            "type": [
              "integer",
              "null"
            ]
          },
          "behind": {
            "type": [
              "integer",
              "null"
            ]
          },
          "sampledAt": {
            "type": "string"
          },
          "changedEntries": {
            "type": "integer"
          },
          "staged": {
            "type": "integer"
          },
          "unstaged": {
            "type": "integer"
          },
          "untracked": {
            "type": "integer"
          },
          "conflicts": {
            "type": "integer"
          },
          "files": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "type": "object",
              "required": [
                "code",
                "path"
              ],
              "properties": {
                "code": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                }
              }
            }
          },
          "lastCommit": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "hash": {
                "type": "string"
              },
              "subject": {
                "type": "string"
              },
              "date": {
                "type": "string"
              }
            }
          }
        }
      },
      "SpaceAnalysis": {
        "type": "object",
        "required": [
          "phase",
          "running",
          "visited",
          "measured",
          "total",
          "totalBytes",
          "startedAt",
          "finishedAt",
          "warnings",
          "candidates"
        ],
        "properties": {
          "phase": {
            "enum": [
              "idle",
              "discovering",
              "measuring",
              "complete"
            ]
          },
          "running": {
            "type": "boolean"
          },
          "visited": {
            "type": "integer"
          },
          "measured": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "totalBytes": {
            "type": "number"
          },
          "startedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "finishedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "projectId",
                "projectName",
                "projectPath",
                "path",
                "category",
                "status",
                "bytes",
                "error"
              ],
              "properties": {
                "projectId": {
                  "type": "string"
                },
                "projectName": {
                  "type": "string"
                },
                "projectPath": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "category": {
                  "enum": [
                    "dependencies",
                    "build",
                    "cache"
                  ]
                },
                "status": {
                  "enum": [
                    "pending",
                    "complete",
                    "error"
                  ]
                },
                "bytes": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "error": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "responses": {
      "Error": {
        "description": "Richiesta non valida (400), accesso negato (403), progetto assente (404), payload eccessivo (413), tipo non JSON (415), metodo non supportato (405) o errore locale (500).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "session": []
    }
  ],
  "paths": {
    "/api/session": {
      "get": {
        "operationId": "getSession",
        "security": [],
        "summary": "Ottiene token, versione e disponibilità di VS Code",
        "responses": {
          "200": {
            "description": "Sessione locale",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "token",
                    "version",
                    "vscode"
                  ],
                  "properties": {
                    "token": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    },
                    "vscode": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/projects": {
      "get": {
        "operationId": "listProjects",
        "summary": "Restituisce l'ultimo catalogo; effettua la prima scansione se necessario",
        "responses": {
          "200": {
            "description": "Catalogo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Catalog"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/scan": {
      "post": {
        "operationId": "scanProjects",
        "summary": "Rilegge config.json e aggiorna il catalogo",
        "responses": {
          "200": {
            "description": "Catalogo aggiornato",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Catalog"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/open": {
      "post": {
        "operationId": "openProject",
        "summary": "Apre una cartella già indicizzata in Finder o VS Code",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "id",
                  "app"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "app": {
                    "type": "string",
                    "enum": [
                      "finder",
                      "vscode"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Comando di apertura accettato da macOS",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok"
                  ],
                  "properties": {
                    "ok": {
                      "const": true
                    }
                  }
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/resources": {
      "get": {
        "operationId": "getResources",
        "summary": "CPU, memoria e disco del Mac; consumi associabili ai progetti",
        "description": "Campioni conservati 5 secondi; richieste concorrenti condividono il lavoro. CPU globale 0–100; CPU processi 100% per core, anche oltre 100%. RAM processi: somma RSS, può contare pagine condivise. Associazione cwd più discendenti; servizi condivisi esclusi. Valori null e avvisi quando non leggibili. Dimensioni cartelle calcolate separatamente con POST /api/resources/disk. Nessun argomento della riga di comando viene restituito.",
        "responses": {
          "200": {
            "description": "Metriche e limitazioni",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Resources"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/resources/disk": {
      "post": {
        "operationId": "measureProjectDisk",
        "summary": "Avvia in background il calcolo dello spazio allocato dei progetti",
        "description": "Solo progetti indicizzati. Include dipendenze, cache e file nascosti, senza seguire symlink. Due misurazioni simultanee, timeout 30 secondi ciascuna. Riutilizza un lavoro già attivo; altrimenti ricalcola tutto. Risultati parziali ed errori in GET /api/resources.",
        "responses": {
          "202": {
            "description": "Avviato o già in corso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "running",
                    "completed",
                    "total"
                  ],
                  "properties": {
                    "running": {
                      "type": "boolean"
                    },
                    "completed": {
                      "type": "integer"
                    },
                    "total": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/runtime": {
      "get": {
        "operationId": "listRuntime",
        "summary": "Comandi salvati e stato dei progetti gestiti",
        "description": "Include i progetti attivi rimossi dal catalogo, così restano arrestabili. I suggerimenti npm non vengono eseguiti automaticamente.",
        "responses": {
          "200": {
            "description": "Risultato",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "projects"
                  ],
                  "properties": {
                    "projects": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/RuntimeProject"
                      }
                    }
                  }
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/runtime/config": {
      "post": {
        "operationId": "configRuntime",
        "summary": "Salva un comando esplicito sul Mac",
        "description": "Scrittura atomica in .local/launch.json. Cartella relativa esistente, risolta senza uscire dal progetto. 409 se il progetto è attivo. Il comando è codice shell esplicitamente configurato dall’utente, eseguito tramite zsh -lc. Nessuna installazione automatica.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "id",
                  "command",
                  "directory",
                  "url"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "command": {
                    "type": "string",
                    "maxLength": 1500
                  },
                  "directory": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "url": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Risultato",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimeProject"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/runtime/start": {
      "post": {
        "operationId": "startRuntime",
        "summary": "Avvia un progetto con il comando salvato",
        "description": "Solo ID del catalogo. Il comando gira in un gruppo dedicato, con log limitati a 64.000 caratteri. La risposta indica l’avvio del comando, non la disponibilità HTTP. 409 se già gestito, dashboard in chiusura o porta dell’URL locale configurato occupata (controllo best effort tramite lsof).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "id"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Risultato",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimeProject"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/runtime/stop": {
      "post": {
        "operationId": "stopRuntime",
        "summary": "Ferma solo un gruppo avviato dalla dashboard",
        "description": "Solo gruppi avviati dalla sessione corrente della dashboard. SIGTERM a tutto il gruppo, poi SIGKILL dopo 3 secondi se necessario. 404 per processi esterni, 503 se macOS nega il segnale. Anche i progetti rimossi dal catalogo restano arrestabili.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "id"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Risultato",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimeProject"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/runtime/logs": {
      "get": {
        "operationId": "getRuntimeLogs",
        "summary": "Ultimo output del comando gestito",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Risultato",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "logs",
                    "status"
                  ],
                  "properties": {
                    "logs": {
                      "type": "string",
                      "maxLength": 64000
                    },
                    "status": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/ports": {
      "get": {
        "operationId": "listPorts",
        "summary": "Porte TCP in ascolto sul Mac e processi visibili",
        "description": "Campioni condivisi per 3 secondi, associazione per cartella di lavoro e prefisso più specifico. Programmi esterni visibili ma non arrestabili dall’API. Gli URL sono tentativi HTTP: non tutti i servizi sono web. Avvisi espliciti in caso di lettura negata o parziale.",
        "responses": {
          "200": {
            "description": "Risultato",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "sampledAt",
                    "warnings",
                    "listeners"
                  ],
                  "properties": {
                    "sampledAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "warnings": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "listeners": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "pid",
                          "name",
                          "address",
                          "port",
                          "projectId",
                          "projectName",
                          "url"
                        ],
                        "properties": {
                          "pid": {
                            "type": "integer"
                          },
                          "name": {
                            "type": "string"
                          },
                          "address": {
                            "type": "string"
                          },
                          "port": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 65535
                          },
                          "projectId": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "projectName": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "url": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/metadata": {
      "get": {
        "operationId": "listProjectMetadata",
        "summary": "Note dei soli progetti indicizzati",
        "description": "",
        "responses": {
          "200": {
            "description": "Risultato locale",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "metadata"
                  ],
                  "properties": {
                    "metadata": {
                      "type": "object",
                      "additionalProperties": {
                        "$ref": "#/components/schemas/ProjectMetadata"
                      }
                    }
                  }
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "post": {
        "operationId": "saveProjectMetadata",
        "summary": "Salva descrizione, cliente, stato e note",
        "description": "Scrittura atomica serializzata in .local/projects.json. ID del catalogo obbligatorio; payload massimo 32 KiB. I file del progetto non vengono modificati.",
        "responses": {
          "200": {
            "description": "Risultato locale",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectMetadata"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "id",
                  "description",
                  "client",
                  "status",
                  "notes"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "client": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "status": {
                    "enum": [
                      "active",
                      "paused",
                      "archived"
                    ]
                  },
                  "notes": {
                    "type": "string",
                    "maxLength": 6000
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/api/project": {
      "get": {
        "operationId": "getProjectSheet",
        "summary": "Scheda, Git, avvio e campione risorse",
        "description": "Git locale, senza fetch; cache 10 secondi, fresh=1 la ignora. Un repository antenato non viene attribuito al sotto-progetto. Stato Git per voci: directory non tracciate contate una volta. URL remoti privati di credenziali, query e frammenti. Singole sezioni non leggibili generano null/avvisi.",
        "responses": {
          "200": {
            "description": "Risultato locale",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "project",
                    "metadata",
                    "git",
                    "runtime",
                    "resource",
                    "warnings"
                  ],
                  "properties": {
                    "project": {
                      "$ref": "#/components/schemas/Project"
                    },
                    "metadata": {
                      "anyOf": [
                        {
                          "$ref": "#/components/schemas/ProjectMetadata"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "git": {
                      "$ref": "#/components/schemas/GitState"
                    },
                    "runtime": {
                      "anyOf": [
                        {
                          "$ref": "#/components/schemas/RuntimeProject"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "resource": {
                      "type": [
                        "object",
                        "null"
                      ]
                    },
                    "warnings": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fresh",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "0",
                "1"
              ]
            }
          }
        ]
      }
    },
    "/api/space": {
      "get": {
        "operationId": "getSpaceAnalysis",
        "summary": "Risultati progressivi dell’analisi spazio",
        "description": "Somma dello spazio allocato dei candidati misurati. Non garantisce lo spazio fisico recuperabile. Risultati in memoria, nessuna eliminazione.",
