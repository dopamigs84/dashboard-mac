    "/api/space/scan": {
      "post": {
        "operationId": "startSpaceAnalysis",
        "summary": "Analizza dipendenze, build e cache dei progetti",
        "description": "Riutilizza un lavoro attivo, altrimenti riparte. Profondità massima 6 e 20.000 cartelle. Symlink esclusi; alberi candidati disgiunti. Due misure du simultanee, timeout 30 secondi. Avvisi per limiti ed errori; dimensioni parziali non usate come complete.",
        "responses": {
          "202": {
            "description": "Risultato locale",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpaceAnalysis"
                }
              }
